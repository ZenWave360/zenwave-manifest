{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zenwave360.io/zenwave-architecture/1.0/schema.json",
  "title": "ZenWave Architecture Manifest",
  "description": "Schema for the ZenWave project architecture manifest.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "version": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "properties": {
          "type": "object",
          "description": "Named variables available for ${variable} interpolation.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "sourcePriority": {
          "type": "array",
          "description": "Ordered source resolution priority for relative service artifacts.",
          "items": {
            "type": "string",
            "enum": [
              "file",
              "http",
              "apicurio"
            ]
          }
        },
        "naming": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "groupIdExpression": {
              "type": "string",
              "description": "Property-path template used by runtime naming resolution, such as ${service.id}."
            },
            "artifactIdExpression": {
              "type": "string",
              "description": "Property-path template used by runtime naming resolution, such as ${artifactName}. artifactName resolves to the explicit artifact name or defaults to the filename without extension."
            }
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "http": {
              "$ref": "#/$defs/httpSource"
            },
            "apicurio": {
              "$ref": "#/$defs/apicurioSource"
            }
          }
        }
      }
    },
    "domains": {
      "type": "object",
      "description": "Top-level architecture domains.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/domain"
      }
    }
  },
  "required": [
    "domains"
  ],
  "$defs": {
    "httpSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "apicurioSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "registryUrl": {
          "type": "string"
        },
        "branch": {
          "type": "string",
          "default": "latest"
        },
        "contentUrlExpression": {
          "type": "string",
          "description": "Property-path template used by runtime naming resolution."
        }
      },
      "required": [
        "registryUrl"
      ]
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "services": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/service"
          }
        },
        "subdomains": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/subdomain"
          }
        }
      }
    },
    "subdomain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "services": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/service"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "Service root path relative to a configured source root."
        },
        "docs": {
          "type": "object",
          "description": "Named documentation resource references relative to the service path or absolute URIs.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "consumers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "Canonical service reference: domain/service or domain/subdomain/service."
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "$ref": {
                    "type": "string",
                    "description": "JSON Pointer or URI-like reference to another manifest service."
                  },
                  "service": {
                    "type": "string"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "$ref"
                    ]
                  },
                  {
                    "required": [
                      "service"
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "required": [
        "path"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Optional logical artifact name. Defaults to the path filename without extension."
        },
        "type": {
          "type": "string",
          "examples": [
            "openapi",
            "asyncapi",
            "zdl",
            "zfl"
          ]
        },
        "path": {
          "type": "string",
          "description": "Artifact path relative to the owning service path, or an absolute URI such as classpath:/..."
        },
        "version": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "type",
        "path"
      ]
    }
  },
  "examples": [
    {
      "config": {
        "sourcePriority": [
          "file",
          "http",
          "apicurio"
        ],
        "naming": {
          "groupIdExpression": "${service.id}",
          "artifactIdExpression": "${artifactName}"
        },
        "sources": {
          "http": {
            "enabled": true,
            "roots": [
              "https://raw.githubusercontent.com/acme",
              "https://docs.acme.io"
            ]
          },
          "apicurio": {
            "enabled": true,
            "registryUrl": "https://registry.acme.io/apis/registry/v2",
            "branch": "latest",
            "contentUrlExpression": "/groups/${groupId}/artifacts/${artifactId}/branches/${branch}"
          }
        }
      },
      "domains": {
        "orders": {
          "services": {
            "orders-api": {
              "path": "/orders-api",
              "docs": {
                "adr": "docs/adr.md"
              },
              "artifacts": [
                {
                  "type": "openapi",
                  "path": "src/main/resources/openapi.yml"
                },
                {
                  "name": "asyncapi-template",
                  "type": "template",
                  "path": "classpath:/templates/asyncapi.hbs"
                }
              ],
              "consumers": [
                "shipping/shipping-api",
                {
                  "service": "billing/billing-api"
                }
              ]
            }
          },
          "subdomains": {
            "checkout": {
              "services": {
                "checkout-api": {
                  "path": "/checkout-api"
                }
              }
            }
          }
        }
      }
    }
  ]
}
